{
  "name": "dsh-intelligent-ui",
  "version": "0.2.1",
  "private": false,
  "type": "module",
  "description": "Rich, interactive UI cards inside DeepSeek Harness chats — streaming, persistent turn cards, Paper Glass visual system.",
  "license": "MIT",
  "author": "simmon-clap",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simmon-clap/dsh-intelligent-ui.git"
  },
  "homepage": "https://github.com/simmon-clap/dsh-intelligent-ui#readme",
  "bugs": {
    "url": "https://github.com/simmon-clap/dsh-intelligent-ui/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "generative-ui",
    "intelligent-ui",
    "paper-glass",
    "render-ui",
    "agent-ui",
    "deepseek-harness-plugin",
    "awesome-dsh-plugin",
    "dsh-plugin-market"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test test/*.test.mjs",
    "check": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
